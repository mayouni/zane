DEFINE CONSTRAINT select_act_collapse_interaction AS (
  ON interaction, WHEN "satisfies contains select and satisfies contains act and not satisfies contains confirm",
  MESSAGE "{name} selects and acts and never confirms: selection expresses interest, never commitment",
  CODE "SELECT_ACT_COLLAPSE"
) RATIONALE "Rule 16; level 2"

DEFINE CONSTRAINT select_act_collapse_feedback AS (
  ON feedback, WHEN "satisfies contains select and satisfies contains act and not satisfies contains confirm",
  MESSAGE "{name} selects and acts and never confirms: selection expresses interest, never commitment",
  CODE "SELECT_ACT_COLLAPSE"
) RATIONALE "Rule 16; level 2"

DEFINE CONSTRAINT select_act_collapse_vibe AS (
  ON vibe, WHEN "satisfies contains select and satisfies contains act and not satisfies contains confirm",
  MESSAGE "{name} selects and acts and never confirms: selection expresses interest, never commitment",
  CODE "SELECT_ACT_COLLAPSE"
) RATIONALE "Rule 16; level 2"

DEFINE CONSTRAINT read_act_collapse_intent_flow AS (
  ON intent_flow, WHEN "satisfies contains read and satisfies contains act",
  MESSAGE "{name} reads and acts: a read surface that silently acts is an intent violation",
  CODE "READ_ACT_COLLAPSE"
) RATIONALE "Rule 16; level 2"

DEFINE CONSTRAINT read_act_collapse_form AS (
  ON form, WHEN "satisfies contains read and satisfies contains act",
  MESSAGE "{name} reads and acts: a read surface that silently acts is an intent violation",
  CODE "READ_ACT_COLLAPSE"
) RATIONALE "Rule 16; level 2"

DEFINE CONSTRAINT read_act_collapse_wizard AS (
