-- ---- the refusals ----------------------------------------------------------------------

DEFINE REFUSAL unknown_verb AS (
  MESSAGE "The Zui declaration is DEFINE <KIND> <name> ( ... ); nothing else opens a declaration."
) RATIONALE "A verb outside the grammar is not forbidden, it is unparseable"

DEFINE REFUSAL unknown_declaration AS (
  MESSAGE "The ten kinds are INTENT_FLOW, FORM, WIZARD, SCREEN, COMPONENT, NAV_GRAPH, WORLD_VIEW, INTERACTION, FEEDBACK and VIBE.",
  NAMED [widget: "WIDGET names a rendering, and a declaration that needs to say card has stopped describing intent", user: "USER is not a kind this language defines"],
  CODES [widget: "UNSPECIFIED_DECLARATION", user: "UNSPECIFIED_DECLARATION"]
) RATIONALE "Two kinds the reference implementation recognises and the language does not define (D2). Warnings in zui.js; errors here"

