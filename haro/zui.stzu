  ON nav_graph, WHEN "satisfies contains select and satisfies contains act and not satisfies contains confirm",
  MESSAGE "{name} selects and acts and never confirms: selection expresses interest, never commitment",
  CODE "SELECT_ACT_COLLAPSE"
) RATIONALE "Rule 16; level 2"

DEFINE CONSTRAINT select_act_collapse_world_view AS (
  ON world_view, WHEN "satisfies contains select and satisfies contains act and not satisfies contains confirm",
  MESSAGE "{name} selects and acts and never confirms: selection expresses interest, never commitment",
  CODE "SELECT_ACT_COLLAPSE"
