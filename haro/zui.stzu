DEFINE CONSTRAINT missing_undo_intent_flow AS (
  ON intent_flow, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_form AS (
  ON form, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_wizard AS (
  ON wizard, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_screen AS (
  ON screen, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_component AS (
  ON component, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_nav_graph AS (
  ON nav_graph, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_world_view AS (
  ON world_view, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_interaction AS (
  ON interaction, WHEN "satisfies contains act and not always_reachable contains undo and not role = irreversible",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_feedback AS (
  ON feedback, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_undo_vibe AS (
  ON vibe, WHEN "satisfies contains act and not always_reachable contains undo",
  MESSAGE "{name} acts and keeps no reachable UNDO: every act has one, or declares why it cannot",
  CODE "MISSING_UNDO"
) RATIONALE "Rule 79; level 2"

DEFINE CONSTRAINT missing_cancel_intent_flow AS (
  ON intent_flow, WHEN "satisfies contains act and not always_reachable contains cancel",
  MESSAGE "{name} acts and keeps no reachable CANCEL",
  CODE "MISSING_CANCEL"
) RATIONALE "Rule 26; level 2"

DEFINE CONSTRAINT missing_cancel_wizard AS (
  ON wizard, WHEN "satisfies contains act and not always_reachable contains cancel",
  MESSAGE "{name} acts and keeps no reachable CANCEL",
  CODE "MISSING_CANCEL"
) RATIONALE "Rule 26; level 2"

DEFINE CONSTRAINT trapped_flow_wizard AS (
  ON wizard, WHEN "not always_reachable contains exit",
  MESSAGE "{name} is multi-step and EXIT is not always reachable: a trapped flow is unconstitutional",
  CODE "TRAPPED_FLOW"
) RATIONALE "Rules 51, 53; level 2"

DEFINE CONSTRAINT expression_orphan_intent_flow AS (
  ON intent_flow, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_form AS (
  ON form, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_wizard AS (
  ON wizard, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_screen AS (
  ON screen, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_component AS (
  ON component, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_nav_graph AS (
  ON nav_graph, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_world_view AS (
  ON world_view, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_interaction AS (
  ON interaction, WHEN "(signals nonempty or role present) and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_feedback AS (
  ON feedback, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT expression_orphan_vibe AS (
  ON vibe, WHEN "signals nonempty and (satisfies absent or satisfies empty)",
  MESSAGE "{name} says how a value is perceived without saying what the operator is doing: expression is intent's refinement, never a second language",
  CODE "EXPRESSION_ORPHAN"
) RATIONALE "Article intent; level 2"

DEFINE CONSTRAINT role_acts_without_consequence AS (
  ON interaction, WHEN "(role = inert or role = navigate) and satisfies contains act",
  MESSAGE "{name} declares a role that has no consequence and satisfies ACT",
  CODE "ROLE_ACTS_WITHOUT_CONSEQUENCE"
) RATIONALE "Rules 119, 112, 16"

DEFINE CONSTRAINT role_promise_broken AS (
  ON interaction, WHEN "role = reversible and not always_reachable contains undo and not satisfies contains act",
  MESSAGE "{name} promises to be reversible and keeps no reachable UNDO",
  CODE "ROLE_PROMISE_BROKEN"
) RATIONALE "Rule 79"

DEFINE CONSTRAINT irreversible_claims_undo AS (
  ON interaction, WHEN "role = irreversible and (always_reachable contains undo or satisfies contains undo)",
  MESSAGE "{name} declares itself irreversible and declares an UNDO: it cannot be both",
  CODE "IRREVERSIBLE_CLAIMS_UNDO"
) RATIONALE "Rule 79"

DEFINE CONSTRAINT proposal_commits AS (
  ON interaction, WHEN "role = proposal and satisfies contains act and actor absent",
  MESSAGE "{name} proposes and acts and names no ACTOR",
  CODE "PROPOSAL_COMMITS"
) RATIONALE "Rules 98, 83"

DEFINE CONSTRAINT decorative_animation_feedback AS (
  ON feedback, WHEN "(tone present or motion present) and (reports absent or reports empty)",
  MESSAGE "{name} speaks or moves and reports nothing: feedback that reports nothing is decoration",
  CODE "DECORATIVE_ANIMATION"
) RATIONALE "Rule 112"

DEFINE CONSTRAINT decorative_animation_vibe AS (
  ON vibe, WHEN "motion present and motion != none and (reports absent or reports empty)",
  MESSAGE "{name} moves and reports nothing: motion that moves must report",
  CODE "DECORATIVE_ANIMATION"
) RATIONALE "Rule 112"

-- ---- the medium axis: two cells of the matrix, as proof (S6) ----------------------------

DEFINE CONSTRAINT verb_not_carried_zoom AS (
  ON vibe, WHEN "(surface_as = auditory or surface_as = voice) and ((some intent_flow where satisfies contains zoom) or (some form where satisfies contains zoom) or (some wizard where satisfies contains zoom) or (some screen where satisfies contains zoom) or (some component where satisfies contains zoom) or (some nav_graph where satisfies contains zoom) or (some world_view where satisfies contains zoom) or (some interaction where satisfies contains zoom) or (some feedback where satisfies contains zoom) or (some vibe where satisfies contains zoom))",
  MESSAGE "{name} projects to a medium that has no ZOOM, and a declaration of this file promises it",
  CODE "VERB_NOT_CARRIED"
) RATIONALE "Rule 82; media.json absent"

DEFINE CONSTRAINT signal_unperceivable_intent_flow AS (
  ON intent_flow, WHEN "signals contains muted and not signals contains success and not signals contains warning and not signals contains danger and not signals contains info and ((some vibe where surface_as = auditory) or (some vibe where surface_as = voice))",
  MESSAGE "{name} carries only the muted signal on a medium where muted is silence",
  CODE "SIGNAL_UNPERCEIVABLE"
) RATIONALE "Rule 82; signal.json absence"

