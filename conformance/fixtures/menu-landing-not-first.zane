// The section's landing page is in its band, under a label of its own, but
// second: the band opens on a page inside the section before the page the
// section itself leads to. The child that leads to the section's TARGET is the
// landing surface, and it comes first.
//
// Expected: MENU_LANDING_NOT_FIRST

DEFINE NAV_GRAPH main_menu (
  SATISFIES [LOCATE],
  ENTRIES [billing, reports]
)

DEFINE NAV_GRAPH billing (
  LABEL "Billing",
  TARGET billing_home,
  ENTRIES [invoices, billing_overview, payments]
)
DEFINE NAV_GRAPH billing_overview (LABEL "Overview", TARGET billing_home)
DEFINE NAV_GRAPH invoices (LABEL "Invoices", TARGET invoice_list)
DEFINE NAV_GRAPH payments (LABEL "Payments", TARGET payment_list)

DEFINE NAV_GRAPH reports (LABEL "Reports", TARGET report_list)
