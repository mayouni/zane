// The exemption FIELD_MISPLACED keeps. STEPS, INTENT_FLOW, VISIBLE_STATE and
// VISIBLE_ENTITIES are declared on WIZARD, FORM, NAV_GRAPH and WORLD_VIEW, and
// the verifier reads each of them on ANY kind -- STEPS makes a flow multi-step,
// INTENT_FLOW is resolved, the other two are collected file-wide -- so off its own
// kind none of them is silent, and the rule behind D1 (the verifier speaks where
// its silence hides an error) does not reach them.
//
// Everything else is lawful on purpose: EXIT is reachable so the STEPS raises
// no TRAPPED_FLOW, and the INTENT_FLOW names a flow declared below. If a later
// edit to the per-kind table starts refusing any of the four, this goes red.
// The court (haro/zayn.stzu) still refuses all four here; that is seam S13.
// Expected: clean

DEFINE INTENT_FLOW review_invoice (
  SATISFIES [READ, CONFIRM]
)

DEFINE SCREEN invoice_review (
  SATISFIES [READ],
  ALWAYS_REACHABLE [EXIT],
  STEPS [open, check, close],
  INTENT_FLOW review_invoice,
  VISIBLE_STATE [filter],
  VISIBLE_ENTITIES [invoice]
)
