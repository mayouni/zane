// Two entries of one band answer to one name: "Invoices" and "The invoices".
// A leading "The" and case do not make two names, so the reader cannot tell
// which of the two entries holds what.
//
// Expected: MENU_LABEL_DUPLICATE

DEFINE NAV_GRAPH main_menu (
  SATISFIES [LOCATE],
  ENTRIES [billing, reports]
)

DEFINE NAV_GRAPH billing (
  LABEL "Billing",
  TARGET billing_home,
  ENTRIES [billing_overview, invoices, payments]
)
DEFINE NAV_GRAPH billing_overview (LABEL "Overview", TARGET billing_home)
DEFINE NAV_GRAPH invoices (LABEL "Invoices", TARGET invoice_list)
DEFINE NAV_GRAPH payments (LABEL "The invoices", TARGET payment_list)

DEFINE NAV_GRAPH reports (LABEL "Reports", TARGET report_list)
