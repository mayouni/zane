// PROJECTION, D5: select-act-collapse with a VIBE that declares SURFACE_AS visual.
// Rule 16 on the row "decide". No fixture declared the visual medium before this one,
// although 94 of the 122 rules are written for it. Visual carries every verb, so nothing about
// the medium should change the verdict: this fixture proves it does not.
//
// Expected: SELECT_ACT_COLLAPSE

DEFINE VIBE screen_surface (
  SURFACE_AS visual
)

DEFINE INTENT_FLOW pick_and_pay (
  SATISFIES [SELECT, ACT],
  ALWAYS_REACHABLE [UNDO, CANCEL, EXIT],
  ACTOR operator
)
